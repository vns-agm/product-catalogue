# Copy to apps/api/.env. Every value is optional; defaults work for local development.

# Named API_PORT (not PORT) so it cannot collide with a PORT meant for the web dev server.
API_PORT=3001
# Only needed if the web app is served from a different origin than the API.
CORS_ORIGIN=

# Product data source: fakestore-api (live) or fakestore-snapshot (committed copy;
# use where fakestoreapi.com blocks your host's IPs, e.g. Vercel).
PRODUCT_SOURCE=fakestore-api
FAKESTORE_BASE_URL=https://fakestoreapi.com
PRODUCT_CACHE_TTL_SECONDS=300
UPSTREAM_TIMEOUT_MS=5000

# Merchandising: the 5 hand-picked "top rated" products on the home page, in order.
FEATURED_PRODUCT_IDS=3,5,12,18,19
CATEGORY_TOP_RATED_COUNT=3

# Database. Local default is a SQLite file; set a libsql:// URL + token for Turso.
DATABASE_URL=file:data/local.db
DATABASE_AUTH_TOKEN=

# Email. "console" prints emails to the API log; "smtp" sends them.
EMAIL_PROVIDER=console
EMAIL_FROM=Catalogue <no-reply@example.com>
SALES_INBOX_EMAIL=sales@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
